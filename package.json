{
  "name": "project-versions",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "查看真实 Git 分支与提交关系，配套 README 同步和安全 Git 收尾技能。",
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx scripts/test-ui.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "playwright": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
